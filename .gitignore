node_modules/
dist/
*.log

# Secrets — never commit
.env
.env.*
!.env.example

# Private keys — never commit
wallets/
keys.txt
*.key

# Runtime caches — contain live API keys in plaintext, never commit
.minter-cache/
.minter-session/

# Per-run logs — contain RPC endpoints, targets, and partial diagnostics
.minter-logs/

# Audit scratch artifacts — regenerated by the audit scripts, not source
dead_exports*.json

# The ignore file itself
.gitignore
