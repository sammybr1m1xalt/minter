# ============================================
# minter — optional configuration
# ============================================
# Everything here is OPTIONAL. The wizard asks for what it needs and these
# values just become the pre-filled defaults.
#
# Copy to .env:   cp .env.example .env
#
# NEVER put private keys in this file. Keys are pasted into the CLI at run
# time, held in memory only, and never written to disk.

# --- RPC endpoints (recommended) ---
# A private RPC is the single biggest factor in whether you win a contested
# mint. Public nodes work but are slower and rate-limited.
# One entry per chain you mint on. You can also paste these at the prompt.
# Comma-separated entries are fine.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ROBINHOOD=
RPC_URL_ARC=
RPC_URL_SONEIUM=

# Generic endpoints, used only when CHAIN below matches the chain you pick.
# RPC_URL is a single endpoint; EXTRA_RPC_URLS is comma-separated.
RPC_URL=
EXTRA_RPC_URLS=

# Per-request RPC timeout in milliseconds.
RPC_TIMEOUT_MS=15000

# --- Default chain highlighted in the menu ---
# ethereum | base | robinhood | arc | soneium
CHAIN=base

# --- Gas defaults (gwei) ---
# Pre-filled at the prompt; you confirm or change them on every run.
# The max fee is a CEILING, not what you pay — you pay base fee + tip. But note
# a node reserves gasLimit × maxFee upfront, so the wallet must hold that much.
MAX_FEE_PER_GAS=2
MAX_PRIORITY_FEE=0.05

# Gas limit per mint tx. A SeaDrop mint uses roughly 135k for quantity 1.
GAS_LIMIT=250000

# --- OpenSea REST API key (optional but recommended for FCFS) ---
# The FCFS/allowlist path needs an OpenSea API key to fetch signed mint data.
# A free key is auto-minted at runtime (no signup needed) and cached to disk
# for 3 days — you do NOT need to paste one here. Leave this blank and the
# tool will obtain and manage its own key automatically.
#
# If you already have a key and want to use it (or prefer to manage it yourself),
# paste it here. The auto-mint logic will still try to use this key first before
# minting a new one. Free key docs: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# Set to 0 to stop the tool mirroring its auto-minted key back into .env.
OPENSEA_KEY_SYNC=1

# Where the auto-minted key pool and SIWE session cookies are cached.
# Project-relative; override only if you want them elsewhere.
OPENSEA_SESSION_DIR=

# --- Headless runs ---
# Supplying any of these makes the wizard load keys instead of prompting, which
# is what makes an unattended `npm start -- --fcfs <slug> --at "in 5m"` possible.
# PRIVATE_KEY is one key; PRIVATE_KEYS is comma-separated; WALLETS_FILE points at
# a JSON file (default wallets.json).
PRIVATE_KEY=
PRIVATE_KEYS=
WALLETS_FILE=

# --- ABI lookups (optional) ---
# Etherscan V2 key, needed for verified ABIs on chains Sourcify does not cover.
ETHERSCAN_API_KEY=
